{
  "sourceLanguage": "he",
  "strings": {
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Photos add-only permission prompt shown by iOS.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the movie you exported to your iPhone photo library."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמירת הסרט שייצאתם בספריית התמונות באייפון."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Photos read permission prompt shown by iOS, for recaps.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your videos and photos only to choose the moments of a trip, month or year recap you asked for. Nothing leaves your iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קריאת הסרטונים והתמונות רק כדי לבחור רגעים לסיכום טיול, חודש או שנה שביקשתם. שום דבר לא יוצא מהאייפון."
          }
        }
      }
    }
  },
  "version": "1.0"
}

          "stringUnit": {
            "state": "translated",
            "value": "%1$@ chosen, the strongest moment at %2$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ נבחרו, הרגע החזק ביותר ב־%2$@"

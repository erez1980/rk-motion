{
  "sourceLanguage": "he",
  "strings": {
    "%@ אחוז": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ percent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ אחוז"
          }
        }
      }
    },
    "%@ שניות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconds"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ שניות"
          }
        }
      }
    },
    "%@ שניות · %@ סרטים שנוצרו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconds · %@ movies created"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ שניות · %@ סרטים שנוצרו"
          }
        }
      }
    },
    "YouTube סירב להוריד את השמע. נסו שוב מאוחר יותר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube refused to download the audio. Try again later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube סירב להוריד את השמע. נסו שוב מאוחר יותר."
          }
        }
      }
    },
    "אודות ועזרה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About & Help"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אודות ועזרה"
          }
        }
      }
    },
    "אורך הסרט הערוך צריך להיות עד 24 שעות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edited movie must be at most 24 hours long."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך הסרט הערוך צריך להיות עד 24 שעות."
          }
        }
      }
    },
    "אחסון מקומי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחסון מקומי"
          }
        }
      }
    },
    "איכות מרבית": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum quality"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איכות מרבית"
          }
        }
      }
    },
    "אין מספיק מקום פנוי באייפון. פנו מקום ונסו שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough free space on this iPhone. Free some space and try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין מספיק מקום פנוי באייפון. פנו מקום ונסו שוב."
          }
        }
      }
    },
    "אין ערוץ וידאו.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No video track."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ערוץ וידאו."
          }
        }
      }
    },
    "אפשרו שמירה בתמונות בהגדרות האייפון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow saving to Photos in your iPhone settings"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרו שמירה בתמונות בהגדרות האייפון"
          }
        }
      }
    },
    "אפשרויות ייצוא": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export options"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשרויות ייצוא"
          }
        }
      }
    },
    "בדקו את בחירת הקטעים, הזמנים והגדרות הייצוא.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the selected clips, their times and the export settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו את בחירת הקטעים, הזמנים והגדרות הייצוא."
          }
        }
      }
    },
    "בוצע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוצע"
          }
        }
      }
    },
    "בחירה מתמונות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Photos"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירה מתמונות"
          }
        }
      }
    },
    "בחירת סרטון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת סרטון"

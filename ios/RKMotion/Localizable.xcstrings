    },
    "%@ שניות · %@ סרטים שנוצרו": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seconds · %@ movies created"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ שניות · %@ סרטים שנוצרו"
          }
        }
      }
    },
    "YouTube סירב להוריד את השמע. נסו שוב מאוחר יותר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube refused to download the audio. Try again later."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube סירב להוריד את השמע. נסו שוב מאוחר יותר."
          }
        }
      }
    },
    "אודות ועזרה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About & Help"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אודות ועזרה"
          }
        }
      }
    },
    "אורך הסרט": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movie length"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך הסרט"
          }
        }
      }
    },
    "אורך הסרט הערוך צריך להיות עד 24 שעות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edited movie must be at most 24 hours long."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך הסרט הערוך צריך להיות עד 24 שעות."
          }
        }
      }
    },
    "אורך הסרט, עם החיתוכים על הקצב": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Movie length, with cuts on the beat"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אורך הסרט, עם החיתוכים על הקצב"
          }
        }
      }
    },
    "אחסון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחסון"
          }
        }
      }
    },
    "אחסון מקומי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local storage"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחסון מקומי"
          }
        }
      }
    },
    "אחתוך את הקטעים החיים ביותר: תנועה, קולות ואנשים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut the liveliest moments: motion, voices and people."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך את הקטעים החיים ביותר: תנועה, קולות ואנשים."
          }
        }
      }
    },
    "אחתוך את הקטעים עם הכי הרבה תנועה ורעש: מהירות, קפיצות וירידות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut the moments with the most motion and noise: speed, jumps and descents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך את הקטעים עם הכי הרבה תנועה ורעש: מהירות, קפיצות וירידות."
          }
        }
      }
    },
    "אחתוך את קטעי הדיבור ואת התגובות של הקהל, ואשאיר את קול המקור.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut the speech and the audience's reactions, and keep the original sound."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך את קטעי הדיבור ואת התגובות של הקהל, ואשאיר את קול המקור."
          }
        }
      }
    },
    "אחתוך את קטעי הריקוד, השמחה והצחוק, ואשתיק את קול המקור כדי שהמוזיקה שלו לא תתנגש בשיר.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut the dancing, joy and laughter, and mute the original sound so its music doesn't clash with the song."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך את קטעי הריקוד, השמחה והצחוק, ואשתיק את קול המקור כדי שהמוזיקה שלו לא תתנגש בשיר."
          }
        }
      }
    },
    "אחתוך את רגעי הצחוק והשמחה ואת הקטעים עם אנשים בפריים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut the moments of laughter and joy and the parts with people in frame."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך את רגעי הצחוק והשמחה ואת הקטעים עם אנשים בפריים."
          }
        }
      }
    },
    "אחתוך רגעים עם תנועה, אנשים בפריים וצחוק, ואשאיר את קול המקור מתחת למוזיקה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll cut moments with motion, people in frame and laughter, and keep the original sound under the music."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחתוך רגעים עם תנועה, אנשים בפריים וצחוק, ואשאיר את קול המקור מתחת למוזיקה."
          }
        }
      }
    },

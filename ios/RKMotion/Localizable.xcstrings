        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המוזיקה נשמרה באייפון"
          }
        }
      }
    },
    "המסה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

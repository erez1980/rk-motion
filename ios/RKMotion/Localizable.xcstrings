    "גרסה %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה %@"
          }
        }
      }
    },
    "דיווחים ב־GitHub ציבוריים. אל תצרפו סרטונים פרטיים או מידע אישי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub reports are public. Do not attach private videos or personal information."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווחים ב־GitHub ציבוריים. אל תצרפו סרטונים פרטיים או מידע אישי."
          }
        }
      }
    },
    "האייפון מכין את הקובץ…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your iPhone is preparing the file…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האייפון מכין את הקובץ…"
          }
        }
      }
    },
    "הגדרות מוזיקה לא תקינות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music settings are not valid."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות מוזיקה לא תקינות."
          }
        }
      }
    },
    "הדביקו קישור לסרטון YouTube.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link to a YouTube video."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו קישור לסרטון YouTube."
          }
        }
      }
    },
    "הדביקו קישור לסרטון. השמע יורד ישירות לאייפון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link to a video. The audio downloads straight to your iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדביקו קישור לסרטון. השמע יורד ישירות לאייפון."
          }
        }
      }
    },
    "ההורדה בוטלה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download was cancelled."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההורדה בוטלה."
          }
        }
      }
    },
    "הוספת מוזיקה מקבצים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music from Files"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת מוזיקה מקבצים"

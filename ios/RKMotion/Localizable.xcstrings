          }
        }
      }
    },
    "הרגעים הבולטים נבחרים לפי תנועה, קולות, דיבור, צחוק ואנשים בפריים, לפי סוג הסרטון שזוהה. אפשר תמיד לשנות את הבחירה." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standout moments are chosen from motion, sound, speech, laughter and people in frame, weighted for the kind of video detected. You can always change the choice."
          }
        },
        "he" : {

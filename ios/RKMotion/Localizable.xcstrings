          }
        }
      }
    },
    "הסרטונים, המוזיקה והעריכות מעובדים ונשמרים באייפון. אין צורך בחשבון ואין שרת עיבוד, פרסומות או כלי מעקב באפליקציה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, music and edits are processed and stored on your iPhone. No account is needed, and the app has no processing server, ads or trackers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרטונים, המוזיקה והעריכות מעובדים ונשמרים באייפון. אין צורך בחשבון ואין שרת עיבוד, פרסומות או כלי מעקב באפליקציה."
          }

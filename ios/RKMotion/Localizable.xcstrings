    "בוצע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בוצע"
          }
        }
      }
    },
    "בחירת סרטון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת סרטון"
          }
        }
      }
    },
    "בחירת סרטון מקבצים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video from Files"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת סרטון מקבצים"
          }
        }
      }
    },
    "בחרו סרטון כדי ליצור את הפרויקט הראשון שלכם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video to create your first project."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו סרטון כדי ליצור את הפרויקט הראשון שלכם."
          }
        }
      }
    },
    "ביטול הפעולה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול הפעולה"
          }
        }
      }
    },
    "ביטול שינוי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול שינוי"
          }
        }
      }
    },
    "גרסה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה"
          }
        }
      }
    },
    "דיווחים ב־GitHub ציבוריים. אל תצרפו סרטונים פרטיים או מידע אישי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub reports are public. Do not attach private videos or personal information."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווחים ב־GitHub ציבוריים. אל תצרפו סרטונים פרטיים או מידע אישי."
          }
        }
      }
    },
    "הוספת מוזיקה מקבצים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add music from Files"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת מוזיקה מקבצים"
          }
        }
      }
    },
    "הוספת קטע ידני": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a clip manually"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוספת קטע ידני"
          }
        }
      }
    },
    "הזנת זמנים מדויקת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter exact times"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזנת זמנים מדויקת"
          }
        }
      }
    },
    "החלת מצב הבחירה על הפרויקט": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this mode to the project"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלת מצב הבחירה על הפרויקט"
          }
        }
      }
    },
    "הייצוא הנוכחי הוא SDR בקצב 30 פריימים לשנייה. זיהוי הפעילות מבוסס על תנועה ועוצמת שמע ומציע קטעים לבדיקה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports are currently SDR at 30 frames per second. Activity detection uses motion and audio level, and suggests clips for you to review."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא הנוכחי הוא SDR בקצב 30 פריימים לשנייה. זיהוי הפעילות מבוסס על תנועה ועוצמת שמע ומציע קטעים לבדיקה."
          }
        }
      }
    },
    "המסה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissolve"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המסה"
          }
        }
      }
    },
    "הסרה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרה"
          }
        }
      }
    },
    "הסרטון כבר ערוך — להשאיר אותו שלם": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video is already edited — keep it whole"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרטון כבר ערוך — להשאיר אותו שלם"
          }
        }
      }
    },
    "הסרטונים, המוזיקה והעריכות מעובדים ונשמרים באייפון. אין צורך בחשבון ואין שרת עיבוד, פרסומות או כלי מעקב באפליקציה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, music and edits are processed and stored on your iPhone. No account is needed, and the app has no processing server, ads or trackers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרטונים, המוזיקה והעריכות מעובדים ונשמרים באייפון. אין צורך בחשבון ואין שרת עיבוד, פרסומות או כלי מעקב באפליקציה."
          }
        }
      }
    },
    "הסרת שמע הרכיבה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute the ride audio"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסרת שמע הרכיבה"
          }
        }
      }
    },
    "הפעולה מחליפה את הקטעים הנוכחיים; אפשר לבטל את השינוי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This replaces the current clips; you can undo the change."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה מחליפה את הקטעים הנוכחיים; אפשר לבטל את השינוי."
          }
        }
      }
    },
    "הפקת הצעות מחדש": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regenerate suggestions"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפקת הצעות מחדש"
          }
        }
      }
    },
    "הפרויקטים שלי": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My projects"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרויקטים שלי"
          }
        }
      }
    },
    "הצעות הפעילות יוחלפו; ניתן לבטל את השינוי.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The activity suggestions will be replaced; you can undo the change."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעות הפעילות יוחלפו; ניתן לבטל את השינוי."
          }
        }
      }
    },
    "התחלה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלה"
          }
        }
      }
    },
    "התצוגה כוללת חיתוכים, סדר, מהירות ומוזיקה ללא ייצוא קובץ.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview includes cuts, order, speed and music, without exporting a file."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצוגה כוללת חיתוכים, סדר, מהירות ומוזיקה ללא ייצוא קובץ."
          }
        }
      }
    },
    "התקדמות העיבוד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processing progress"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקדמות העיבוד"
          }
        }
      }
    },
    "חזק": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loud"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזק"
          }
        }
      }
    },
    "חיתוך": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיתוך"
          }
        }
      }
    },
    "חיתוך הקטע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trim the clip"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיתוך הקטע"
          }
        }
      }
    },
    "חיתוך קטע": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trim clip"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיתוך קטע"
          }
        }
      }
    },
    "יכולת העיבוד ברקע תלויה בגרסה, במכשיר ובהרשאות החתימה. iOS יכולה לעצור פעולה; המקור והעריכה נשמרים, ואפשר לנסות שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background processing depends on your iOS version, your device and the signing entitlements. iOS may stop the work; the source and the edit are kept, and you can try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יכולת העיבוד ברקע תלויה בגרסה, במכשיר ובהרשאות החתימה. iOS יכולה לעצור פעולה; המקור והעריכה נשמרים, ואפשר לנסות שוב."
          }
        }
      }
    },
    "כל הייצואים הם SDR ב־30fps. רזולוציית מקור אינה שימור HDR או ייצוא ללא אובדן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All exports are SDR at 30fps. Source resolution does not mean HDR preservation or lossless export."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הייצואים הם SDR ב־30fps. רזולוציית מקור אינה שימור HDR או ייצוא ללא אובדן."
          }
        }
      }
    },
    "מאוזן": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאוזן"
          }
        }
      }
    },
    "מהירות": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהירות"
          }
        }
      }
    },
    "מהרכיבה לרגעים הטובים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the ride to the best moments"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהרכיבה לרגעים הטובים"
          }
        }
      }
    },
    "מחיקה": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקה"
          }
        }
      }
    },
    "מחיקת הסרט": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the movie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת הסרט"
          }
        }
      }
    },
    "מחיקת הפרויקט מהאייפון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the project from this iPhone"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת הפרויקט מהאייפון"
          }
        }
      }
    },
    "מחיקת סרט שנוצר אינה מוחקת את המקור או את העריכה. עותקים שנשמרו בתמונות אינם נמחקים.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a finished movie does not delete the source or the edit. Copies already saved to Photos are not deleted."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת סרט שנוצר אינה מוחקת את המקור או את העריכה. עותקים שנשמרו בתמונות אינם נמחקים."
          }
        }
      }
    },
    "מחיקת פרויקט מוחקת את קבציו באפליקציה. עותקים ששמרתם בתמונות או שיתפתם נשארים ביעד שלהם. גיבויי המכשיר עשויים לכלול נתוני אפליקציה בהתאם להגדרות Apple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a project removes its files from the app. Copies you saved to Photos or shared stay where they are. Device backups may include app data, depending on your Apple settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיקת פרויקט מוחקת את קבציו באפליקציה. עותקים ששמרתם בתמונות או שיתפתם נשארים ביעד שלהם. גיבויי המכשיר עשויים לכלול נתוני אפליקציה בהתאם להגדרות Apple."
          }
        }
      }
    },
    "מסגרת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Framing"

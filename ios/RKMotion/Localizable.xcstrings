        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייצוא סרטון רכיבה"
          }
        }
      }
    },
    "יכולת העיבוד ברקע תלויה בגרסה, במכשיר ובהרשאות החתימה. iOS יכולה לעצור פעולה; המקור והעריכה נשמרים, ואפשר לנסות שוב.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background processing depends on your iOS version, your device and the signing entitlements. iOS may stop the work; the source and the edit are kept, and you can try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יכולת העיבוד ברקע תלויה בגרסה, במכשיר ובהרשאות החתימה. iOS יכולה לעצור פעולה; המקור והעריכה נשמרים, ואפשר לנסות שוב."
          }
        }
      }
    },
    "כל הייצואים הם SDR ב־30fps. רזולוציית מקור אינה שימור HDR או ייצוא ללא אובדן.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All exports are SDR at 30fps. Source resolution does not mean HDR preservation or lossless export."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל הייצואים הם SDR ב־30fps. רזולוציית מקור אינה שימור HDR או ייצוא ללא אובדן."
          }
        }
      }
    },

      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select clips to export"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו קטעים לייצוא"
          }
        }
      }
    },

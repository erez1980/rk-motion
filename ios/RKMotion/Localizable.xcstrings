    "בחירת סרטון מקבצים": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video from Files"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחירת סרטון מקבצים"
          }
        }
      }
    },
    "בחרו לפחות קטע אחד": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one clip"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו לפחות קטע אחד"
          }
        }
      }
    },
    "בחרו סרטון כדי ליצור את הפרויקט הראשון שלכם.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a video to create your first project."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו סרטון כדי ליצור את הפרויקט הראשון שלכם."
          }
        }
      }
    },
    "בחרו סרטון תקין באורך של עד 24 שעות.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid video of up to 24 hours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו סרטון תקין באורך של עד 24 שעות."
          }
        }
      }
    },
    "בחרו קובץ שמע תקין.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a valid audio file."

      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדה"
          }
        }
      }
    },
    "הורדת מוזיקה מ־YouTube": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download music from YouTube"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הורדת מוזיקה מ־YouTube"
          }
        }
      }
    },
    "הזנת זמנים מדויקת": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter exact times"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזנת זמנים מדויקת"
          }
        }
      }
    },
    "החלת מצב הבחירה על הפרויקט": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply this mode to the project"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלת מצב הבחירה על הפרויקט"
          }
        }
      }
    },
    "הייצוא אינו זמין במכשיר זה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export is not available on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא אינו זמין במכשיר זה."
          }
        }
      }
    },
    "הייצוא בוטל. העריכה נשמרה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export cancelled. The edit was saved."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא בוטל. העריכה נשמרה."
          }
        }
      }
    },
    "הייצוא הנוכחי הוא SDR בקצב 30 פריימים לשנייה. זיהוי הפעילות מבוסס על תנועה ועוצמת שמע ומציע קטעים לבדיקה.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports are currently SDR at 30 frames per second. Activity detection uses motion and audio level, and suggests clips for you to review."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא הנוכחי הוא SDR בקצב 30 פריימים לשנייה. זיהוי הפעילות מבוסס על תנועה ועוצמת שמע ומציע קטעים לבדיקה."
          }
        }
      }
    },
    "הייצוא נכשל באייפון.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export failed on this iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא נכשל באייפון."
          }
        }
      }
    },
    "המוזיקה נשמרה באייפון": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The music was saved on this iPhone"
